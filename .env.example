# Canonical site URL (no trailing slash). Strongly recommended for Open Graph / WhatsApp (og:image).
# On Vercel, the app also uses VERCEL_PROJECT_PRODUCTION_URL when this is unset.
# Production: https://yourdomain.com or https://yourproject.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Firebase (client) — from Project settings in the Firebase console.
# Realtime Database URL looks like https://YOUR_PROJECT.firebaseio.com

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stat Strike Mac app paths (FirebaseService.swift): unanimousExports/{date}, selections/{date}
# Optional overrides if you ever change the root keys:
# NEXT_PUBLIC_FIREBASE_UNANIMOUS_EXPORTS_ROOT=unanimousExports
# NEXT_PUBLIC_FIREBASE_SELECTIONS_ROOT=selections

# Calendar day used in those paths (should match DailySelection.date / upload key). Default UK.
# NEXT_PUBLIC_PICKS_DATE_TIMEZONE=Europe/London

# When selections/{date} omits leaguePerformance, still show unanimousExports + manualExports picks
# (default: unset = hide non-manual picks until leaguePerformance loads, matching strict BPL filter).
# NEXT_PUBLIC_BEST_PICKS_UNFILTERED_WHEN_NO_LEAGUE_PERFORMANCE=true

# BPL hub (football-predictions home): GET /api/football-predictions/bpl-payload?day=YYYY-MM-DD (London, same as client) reads Stat Strike data and writes
# All Time + compact fixture snapshots under this path (public read; server Admin SDK only). Default: footballPredictions/bplHub
# BPL_HUB_RTDB_PATH=footballPredictions/bplHub

# Google AdSense — Auto ads: script loads on /football-predictions and /blog (see app/football-predictions/layout.tsx, app/blog/layout.tsx).
# Enable Auto ads for this domain in AdSense. Optional: override publisher id if you use a different account.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6299348707363839

# Today’s Best Picks — extended header/footer nav (How apps work, Blog, etc.). Set to 0 to hide without reverting code.
# NEXT_PUBLIC_BEST_PICKS_EXTENDED_SITE_NAV=0

# --- Owner admin: manual picks + video (POST /api/admin/manual-picks) ---
# Long random secret; you paste it on /admin/picks (Bearer token).
# ADMIN_MANUAL_PICKS_KEY=
# Service account JSON (single line) from Firebase → Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional duplicate of DB URL for server; falls back to NEXT_PUBLIC_FIREBASE_DATABASE_URL.
# FIREBASE_DATABASE_URL=
# Required for blog image uploads if the default bucket does not exist: exact name from Firebase → Storage / Project settings.
# If unset, code uses {project_id}.appspot.com from FIREBASE_SERVICE_ACCOUNT_JSON — newer projects may use *.firebasestorage.app instead.
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# or: FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Optional RTDB root for owner-written data (default manualExports). Must match client.
# NEXT_PUBLIC_FIREBASE_MANUAL_EXPORTS_ROOT=manualExports
#
# Hub video (YouTube): RTDB path `hubVideo` (public read in rules). Persists until updated via
# GET/POST /api/admin/hub-video. See lib/hub-video.ts for suggested rules.
#
# Blog posts: RTDB path `blogPosts/{slug}` (public read in rules). Same ADMIN_MANUAL_PICKS_KEY gates
# GET/POST/PATCH/DELETE /api/admin/blog-posts and POST /api/admin/blog-media. See lib/blog-post.ts for suggested rules.
#
# “And Another Thing…” micro-feed: default RTDB `andAnotherThing/posts/{id}`. Public GET /api/and-another-thing;
# admin GET/POST/DELETE /api/admin/and-another-thing; image POST /api/admin/and-another-thing-media. See lib/and-another-thing.ts.
# AND_ANOTHER_THING_POSTS_PATH=andAnotherThing/posts

# Predictions hub — “Today's Research Selections” / research panel reads: {root}/{yyyy-MM-dd}
# Default root: researchAlgorithmSelections (allow client read in RTDB rules).
# NEXT_PUBLIC_FIREBASE_RESEARCH_SELECTIONS_ROOT=researchAlgorithmSelections

# Daily consensus strip (All Models Best Forecaster upload). Default: dailyConsensusSelections/{yyyy-MM-dd}
# NEXT_PUBLIC_FIREBASE_DAILY_CONSENSUS_ROOT=dailyConsensusSelections

# Goal Band Cascade teaser on Research (All Models Best Forecaster upload). Default: goalBandCascadeSelections/{yyyy-MM-dd}
# NEXT_PUBLIC_FIREBASE_GOAL_BAND_CASCADE_ROOT=goalBandCascadeSelections

# Optional RTDB root for public “prediction idea” form submissions (Admin SDK only). Default: predictionIdeaSubmissions
# Optional blocklist root (Admin SDK + checked on POST). Default: predictionIdeaBlockedEmails
# FIREBASE_PREDICTION_IDEA_BLOCKLIST_ROOT=predictionIdeaBlockedEmails
# FIREBASE_PREDICTION_IDEA_SUBMISSIONS_ROOT=predictionIdeaSubmissions
# FIREBASE_MANUAL_EXPORTS_ROOT=

# Optional: email a copy of each prediction-idea submission to your Gmail (or any address Gmail can send to).
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords → Mail / Other.
# GMAIL_SMTP_USER=you@gmail.com
# GMAIL_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# PREDICTION_IDEA_NOTIFY_EMAIL=you@gmail.com
# If PREDICTION_IDEA_NOTIFY_EMAIL is omitted, mail goes to GMAIL_SMTP_USER.

# Optional RTDB root for StatStrike Android closed-test feedback form (Admin SDK only). Default: statstrikeBetaFeedbackSubmissions
# FIREBASE_STATSTRIKE_BETA_FEEDBACK_ROOT=statstrikeBetaFeedbackSubmissions
# Optional notify inbox for StatStrike beta feedback; falls back to PREDICTION_IDEA_NOTIFY_EMAIL then GMAIL_SMTP_USER.
# STATSTRIKE_BETA_NOTIFY_EMAIL=you@gmail.com

# --- Field of Wealth / DGC web tool (unlisted beta) ---
# Comma-separated hostnames that serve the browser editor (subdomain on this Vercel project).
# DGC_HUB_HOSTS=dgc.jmclarenscripts.vercel.app
# Canonical public URL shared with clients once the subdomain is live.
# DGC_PUBLIC_URL=https://dgc.jmclarenscripts.vercel.app
# NEXT_PUBLIC_DGC_URL=https://dgc.jmclarenscripts.vercel.app
# Set to 1 after adding dgc.jmclarenscripts.vercel.app in Vercel Domains (enables /dgc redirect).
# DGC_SUBDOMAIN_ENABLED=1

# --- StatStrike Web (GoalLab hero embed + /statstrike) ---
# Kill switch: unset or 0 = GoalLab keeps the featured fixture card; /statstrike app routes 404.
# Set to 1 to show branded StatStrike live board in the hero right cell and enable /statstrike.
# NEXT_PUBLIC_STATSTRIKE_WEB_ENABLED=1
# Coming Soon blur is NOT an env flag — toggle live on /admin/picks (RTDB statstrikeWebConfig.blur).
# Missing RTDB node defaults to blur ON. Stripe / paywall / login still deferred.
# Debug only: unlock Your Picks / My Record IndexedDB without Stripe (default off / App Store gated).
# NEXT_PUBLIC_STATSTRIKE_PERSONAL_ENABLED=1
