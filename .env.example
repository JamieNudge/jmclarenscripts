# Canonical site URL (no trailing slash). Strongly recommended for Open Graph / WhatsApp (og:image).
# On Vercel, the app also uses VERCEL_PROJECT_PRODUCTION_URL when this is unset.
# Production: https://yourdomain.com or https://yourproject.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Firebase (client) — from Project settings in the Firebase console.
# Realtime Database URL looks like https://YOUR_PROJECT.firebaseio.com

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stat Strike Mac app paths (FirebaseService.swift): unanimousExports/{date}, selections/{date}
# Optional overrides if you ever change the root keys:
# NEXT_PUBLIC_FIREBASE_UNANIMOUS_EXPORTS_ROOT=unanimousExports
# NEXT_PUBLIC_FIREBASE_SELECTIONS_ROOT=selections

# Calendar day used in those paths (should match DailySelection.date / upload key). Default UK.
# NEXT_PUBLIC_PICKS_DATE_TIMEZONE=Europe/London

# Google AdSense — Auto ads: script loads only on /best-picks (components/AdSenseLoader.tsx).
# Enable Auto ads for this domain in AdSense. Optional: override publisher id if you use a different account.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-6299348707363839

# --- Owner admin: manual picks + video (POST /api/admin/manual-picks) ---
# Long random secret; you paste it on /admin/picks (Bearer token).
# ADMIN_MANUAL_PICKS_KEY=
# Service account JSON (single line) from Firebase → Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional duplicate of DB URL for server; falls back to NEXT_PUBLIC_FIREBASE_DATABASE_URL.
# FIREBASE_DATABASE_URL=
# Optional RTDB root for owner-written data (default manualExports). Must match client.
# NEXT_PUBLIC_FIREBASE_MANUAL_EXPORTS_ROOT=manualExports

# Best Picks — “Latest Research Algorithm's Selections” panel reads: {root}/{yyyy-MM-dd}
# Default root: researchAlgorithmSelections (allow client read in RTDB rules).
# NEXT_PUBLIC_FIREBASE_RESEARCH_SELECTIONS_ROOT=researchAlgorithmSelections

# Optional RTDB root for public “prediction idea” form submissions (Admin SDK only). Default: predictionIdeaSubmissions
# FIREBASE_PREDICTION_IDEA_SUBMISSIONS_ROOT=predictionIdeaSubmissions
# FIREBASE_MANUAL_EXPORTS_ROOT=
